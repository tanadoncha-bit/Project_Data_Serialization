<% const browse = typeof browseConfig !== 'undefined' ? browseConfig : {}; const sourceOptions = browse.sourceOptions || [['all','ทั้งหมด'],['chef','จากเชฟ'],['general','ทั่วไป']]; const sortOptions = browse.sortOptions || [['popular','ยอดนิยม'],['rating','คะแนนสูงสุด'],['newest','ใหม่ล่าสุด']]; %>
<div class="recipe-browse-controls">
  <div class="recipe-browse-toolbar">
    <% if (browse.showSource !== false) { %>
    <div class="recipe-difficulty-select">
      <span id="recipe-level-label"><%= browse.sourceLabel || 'แหล่งที่มา' %>:</span>
      <details class="recipe-difficulty-control">
        <summary aria-labelledby="recipe-level-label recipe-level-value"><span id="recipe-level-value"><%= (sourceOptions.find(option => option[0] === filters.source) || sourceOptions[0])[1] %></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary>
        <div class="recipe-difficulty-menu" role="group" aria-labelledby="recipe-level-label">
          <% sourceOptions.forEach(([value, label]) => { %>
          <label class="recipe-difficulty-option"><input type="radio" name="source" value="<%= value %>" data-submit-change <%= filters.source === value ? 'checked' : '' %>><span><%= label %></span></label>
          <% }); %>
        </div>
      </details>
    </div>
    <% } %>
    <div class="recipe-sort-options" role="group" aria-label="<%= browse.sortLabel || 'เรียงลำดับรายการ' %>"><span>เรียงตาม:</span>
      <% sortOptions.forEach(([value,
              label])=> { %><button type="button" data-sort="<%= value %>" class="<%= filters.sort === value ? 'active' : '' %>">
        <%= label %>
      </button>
      <% }); %><input type="hidden" name="sort" value="<%= filters.sort %>">
    </div>
  </div>
  <button type="button" class="recipe-btn recipe-filter-button" data-open-filter><i data-lucide="sliders-horizontal"></i> ตัวกรอง</button>
</div>