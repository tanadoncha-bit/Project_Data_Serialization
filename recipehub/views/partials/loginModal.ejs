<dialog class="auth-modal" id="loginModal" aria-labelledby="loginTitle">
  <button type="button" class="auth-close" data-close-auth aria-label="ปิด"><i data-lucide="x"></i></button>

  <div class="auth-logo"><i data-lucide="chef-hat"></i></div>
  <h2 id="loginTitle">ยินดีต้อนรับกลับสู่ CookHub!</h2>
  <p class="auth-sub">เข้าสู่ระบบเพื่อค้นหาเมนูโปรด และจัดการสูตรอาหารของคุณ</p>

  <form id="loginForm" class="auth-form" novalidate>
    <p class="auth-error" role="alert" hidden></p>

    <label for="loginId">Username หรือ Email</label>
    <input type="text" id="loginId" name="login" placeholder="enter your username or email" autocomplete="username" required>

    <label for="loginPassword">Password</label>
    <input type="password" id="loginPassword" name="password" placeholder="enter your password" autocomplete="current-password" required>

    <button type="submit" class="auth-submit">Continue</button>
  </form>

  <p class="auth-switch">ยังไม่มีบัญชี CookHub? <a href="/register" data-open-register>สมัครสมาชิก</a></p>
</dialog>
