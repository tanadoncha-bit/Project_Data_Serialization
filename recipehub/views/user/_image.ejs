<% const hasSrc = locals.src && /^(https?:\/\/|\/uploads\/|\/images\/)/i.test(locals.src); %>
<% if (hasSrc) { %>
<img class="<%= locals.cls || '' %>" src="<%= locals.src %>" alt="<%= locals.alt || '' %>" loading="lazy" referrerpolicy="no-referrer" onerror="this.hidden = true; this.nextElementSibling.hidden = false;">
<% } %>
<div class="<%= locals.cls || '' %> img-placeholder" role="img" aria-label="ยังไม่มีรูป" <%= hasSrc ? 'hidden' : '' %>><i data-lucide="<%= locals.icon || 'utensils' %>"></i></div>