<% const watchUrl = course.kind === 'single' ? '/courses/' + course.id : '/courses/pack/' + course.id; %>
<% const favUrl = '/courses/favorites/' + course.kind + '/' + course.id; %>
<% const buyArea = () => { %>
  <% if (canWatch) { %>
    <a href="<%= watchUrl %>" class="btn btn--primary cm-cta"><i data-lucide="circle-play" class="ic-16"></i> <%= isOwner && !purchased ? 'ดูคอร์สของคุณ' : 'เริ่มเรียนคอร์สนี้' %></a>
  <% } else { %>
    <button type="button" class="btn btn--primary cm-cta" data-buy-course data-kind="<%= course.kind %>" data-id="<%= course.id %>"><i data-lucide="shopping-cart" class="ic-16"></i> ซื้อคอร์สนี้</button>
  <% } %>
<% } %>

<% if (!course.isPack) { %>
<article class="cm cm--single">
  <div class="cm-cover">
    <%- include('_image', { src: course.images[0], alt: course.title, cls: 'cm-cover__img' }) %>
    <div class="cm-cover__actions">
      <button class="fav cm-round <%= favorite ? 'on' : '' %>" type="button" data-fav-url="<%= favUrl %>" aria-pressed="<%= favorite %>" aria-label="รายการโปรด"><i data-lucide="heart" class="ic-18"></i></button>
      <button class="cm-round" type="button" data-close-course aria-label="ปิด"><i data-lucide="x" class="ic-18"></i></button>
    </div>
  </div>

  <div class="cm-top">
    <div class="cm-info">
      <span class="tag tag--<%= course.tagType %> cm-tag"><%= course.tag %></span>
      <h2 class="cm-title"><%= course.title %></h2>
      <% if (course.description) { %><p class="cm-desc"><%= course.description %></p><% } %>
      <div class="cm-meta">
        <span><i data-lucide="circle-play" class="ic-14"></i><%= lessonCount %> บทเรียน</span>
        <span><i data-lucide="clock-3" class="ic-14"></i><%= course.duration %></span>
        <span><i data-lucide="users" class="ic-14"></i><%= course.students %> คนเรียน</span>
        <span><i data-lucide="signal" class="ic-14"></i>ระดับ<%= levelText %></span>
      </div>
    </div>

    <aside class="cm-chef">
      <span class="cm-chef__badge">ผู้สอน</span>
      <div class="cm-chef__row">
        <%- include('_image', { src: chefInfo.avatar, alt: '', cls: 'cm-chef__avatar', icon: 'chef-hat' }) %>
        <div>
          <div class="cm-chef__name"><%= chefInfo.name %></div>
          <% if (chefInfo.institution) { %><div class="cm-chef__sub"><%= chefInfo.institution %></div><% } %>
        </div>
      </div>
      <% if (chefInfo.bio) { %><p class="cm-chef__bio"><%= chefInfo.bio %></p><% } %>
      <div class="cm-chef__buy">
        <% if (!canWatch) { %><span class="price"><%= course.price ? '฿' + course.price.toLocaleString('en-US') : 'ฟรี' %></span><% } %>
        <% buyArea() %>
      </div>
    </aside>
  </div>

  <section class="cm-box cm-lessons">
    <h3 class="cm-box__title"><i data-lucide="square-play" class="ic-18"></i> เนื้อหาหลักสูตร (<%= lessonCount %> บทเรียน)</h3>
    <% if (!lessonCount) { %><p class="empty">ยังไม่มีบทเรียน</p><% } %>
    <ol class="cm-lesson-list">
      <% sections[0].videos.forEach(v => { %>
        <li class="cm-lesson">
          <%- include('_image', { src: v.thumb, alt: '', cls: 'cm-lesson__thumb', icon: 'circle-play' }) %>
          <div class="cm-lesson__text">
            <div class="cm-lesson__title"><%= v.title %></div>
          </div>
          <span class="cm-lesson__time"><%= v.durationText %></span>
          <% if (canWatch) { %>
            <a href="<%= watchUrl %>" class="cm-lesson__icon is-play" aria-label="เล่น <%= v.title %>"><i data-lucide="play" class="ic-14"></i></a>
          <% } else { %>
            <span class="cm-lesson__icon is-lock" aria-label="ล็อก"><i data-lucide="lock" class="ic-14"></i></span>
          <% } %>
        </li>
      <% }) %>
    </ol>
  </section>

  <% if (learnPoints.length) { %>
  <section class="cm-box">
    <h3 class="cm-box__title"><i data-lucide="list-checks" class="ic-18"></i> สิ่งที่คุณจะได้เรียนรู้</h3>
    <ul class="cm-learn"><% learnPoints.forEach(p => { %><li><i data-lucide="circle-check" class="ic-14"></i><%= p %></li><% }) %></ul>
  </section>
  <% } %>
</article>

<% } else { %>
<article class="cm cm--pack">
  <button class="cm-round cm-pack-close" type="button" data-close-course aria-label="ปิด"><i data-lucide="x" class="ic-18"></i></button>

  <div class="cm-pack-images">
    <% sections.forEach((s, i) => { %>
      <a href="<%= s.url %>" class="cm-pack-item" data-course-modal>
        <%- include('_image', { src: s.image, alt: s.title, cls: 'cm-pack-item__img' }) %>
        <span class="cm-pack-item__label"><strong><%= i + 1 %>. <%= s.title %></strong><% if (s.description) { %><small><%= s.description %></small><% } %></span>
      </a>
    <% }) %>
    <% if (!sections.length) { %><div class="cm-pack-item"><%- include('_image', { src: '', alt: '', cls: 'cm-pack-item__img' }) %></div><% } %>
  </div>

  <div class="cm-pack-info">
    <div class="cm-tags">
      <span class="tag tag--<%= course.tagType %>"><%= course.tag %></span>
      <span class="tag tag--pack">แพ็กคอร์ส</span>
    </div>
    <h2 class="cm-title"><%= course.title %></h2>
    <% if (course.description) { %><p class="cm-desc"><%= course.description %></p><% } %>

    <div class="cm-chef__row cm-pack-chef">
      <%- include('_image', { src: chefInfo.avatar, alt: '', cls: 'cm-chef__avatar', icon: 'chef-hat' }) %>
      <div>
        <div class="cm-chef__name"><%= chefInfo.name %></div>
        <% if (chefInfo.institution) { %><div class="cm-chef__sub"><%= chefInfo.institution %></div><% } %>
      </div>
    </div>

    <div class="cm-stats">
      <div><i data-lucide="clock-3" class="ic-18"></i><strong><%= course.duration %></strong><small>เวลาเรียนรวม</small></div>
      <div><i data-lucide="square-play" class="ic-18"></i><strong><%= lessonCount %> บทเรียน</strong><small>บทเรียนทั้งหมด</small></div>
      <div><i data-lucide="users" class="ic-18"></i><strong><%= course.students %> ผู้เรียน</strong><small>ผู้เรียนในแพ็กนี้</small></div>
    </div>

    <h3 class="cm-subtitle">รายละเอียดคอร์ส</h3>
    <p class="cm-desc">แพ็กนี้รวม <%= sections.length %> คอร์ส: <%= sections.map(s => s.title).join(', ') %></p>

    <% if (learnPoints.length) { %>
      <h3 class="cm-subtitle">สิ่งที่คุณจะได้เรียนรู้</h3>
      <ul class="cm-learn"><% learnPoints.forEach(p => { %><li><i data-lucide="circle-check" class="ic-14"></i><%= p %></li><% }) %></ul>
    <% } %>

    <div class="cm-pack-buy">
      <% if (!canWatch) { %><span class="price"><%= course.price ? '฿' + course.price.toLocaleString('en-US') : 'ฟรี' %></span><% } %>
      <button class="fav cm-round <%= favorite ? 'on' : '' %>" type="button" data-fav-url="<%= favUrl %>" aria-pressed="<%= favorite %>" aria-label="รายการโปรด"><i data-lucide="heart" class="ic-18"></i></button>
      <% buyArea() %>
    </div>
  </div>
</article>
<% } %>
