<div class="recipe-detail recipe-external-detail recipe-local-detail">
  <header class="recipe-external-hero">
    <div class="recipe-external-media"><% if (canAccess && videoEmbed) { %><iframe class="recipe-video" src="<%= videoEmbed %>" title="วิดีโอสอนทำ <%= recipe.title %>" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe><% } else { %><%- include('_image', { recipe }) %><% } %></div>
    <div class="recipe-external-intro">
      <span class="recipe-tag <%= (recipe.publisher && recipe.publisher.role === 'chef') || typeof chefName !== 'undefined' ? 'recipe-tag-chef' : '' %>"><%= countryLabel(localCountry(recipe.category)) %></span>
<div class="recipe-local-intro-grid"><div class="recipe-local-title"><h1><%= recipe.title %></h1>

      <% if (recipe.description) { %><p class="recipe-description recipe-muted"><%= recipe.description %></p><% } %></div>      <div class="recipe-author-strip"><span class="recipe-author-avatar"><% const author = recipe.publisher && recipe.publisher.name ? recipe.publisher : (typeof recipeChefInfo !== 'undefined' ? recipeChefInfo : {name:typeof chefName !== 'undefined' ? chefName : 'เจ้าของสูตร'}); %><% if (author.avatar) { %><img src="<%= author.avatar %>" alt=""><% } else { %><i data-lucide="user-round" aria-hidden="true"></i><% } %></span><div><span class="recipe-author-caption">ผู้สร้างสูตร</span><strong><%= author.name %></strong><% if(author.institution || author.bio) { %><% if(author.institution) { %><small><%= author.institution %></small><% } %><% if(author.bio) { %><p class="recipe-author-bio"><%= author.bio %></p><% } %><% } %></div></div></div>
      <div class="recipe-external-summary"><span><i data-lucide="clock-3"></i><%= recipe.duration == null ? 'ไม่ระบุเวลา' : recipe.duration + ' นาที' %></span><span><i data-lucide="shopping-basket"></i><%= (recipe.ingredients || []).length %> วัตถุดิบ</span><span><i data-lucide="list-ordered"></i><%= (recipe.steps || []).length %> ขั้นตอน</span><span><i data-lucide="star"></i><%= recipe.rating == null ? 'ยังไม่มีรีวิว' : recipe.rating.toFixed(1) %></span></div>
    </div>
  </header>
  <% if (canAccess) { %>
  <div class="recipe-detail-grid">
    <section class="recipe-detail-panel recipe-external-ingredients">
      <h2><i data-lucide="shopping-basket"></i> วัตถุดิบ</h2>
      <ul class="recipe-ingredients">
        <% (recipe.ingredients || []).forEach(item=> { %><li><span>
            <%= item.name %>
          </span><span>
            <%= item.amount %>
          </span></li>
        <% }); %>
      </ul>
      <% if (!recipe.ingredients || !recipe.ingredients.length) { %>
      <p class="recipe-muted">ยังไม่มีข้อมูลวัตถุดิบ</p>
      <% } %>
    </section>
    <section class="recipe-detail-panel">
      <h2><i data-lucide="chef-hat"></i> วิธีทำ</h2>
      <ol class="recipe-external-steps">
        <% (recipe.steps || []).forEach((step, i)=> { %><li><span class="recipe-external-step-number">
            <%= i + 1 %>
          </span>
          <p><%= step.description %></p>
        </li>
        <% }); %>
      </ol>
      <% if (!recipe.steps || !recipe.steps.length) { %>
      <p class="recipe-muted">ยังไม่มีข้อมูลขั้นตอน</p>
      <% } %>
    </section>
  </div>
  <% } else { %>
  <section class="recipe-locked">
    <div class="recipe-locked-placeholder" aria-hidden="true">
      <div>
        <h2>วัตถุดิบ</h2>
        <% for (let i=0; i < 5; i++) { %>
        <div class="recipe-skeleton-line"></div>
        <% } %>
      </div>
      <div>
        <h2>ขั้นตอนการทำ</h2>
        <% for (let i=0; i < 3; i++) { %>
        <div class="recipe-skeleton-step"></div>
        <% } %>
      </div>
    </div>
    <div class="recipe-lock-overlay"><i data-lucide="lock-keyhole"></i>
      <h2>ปลดล็อกเนื้อหาสูตรเพื่อดูทั้งหมด</h2><button class="recipe-btn recipe-primary" type="button" data-purchase-recipe="<%= recipe._id %>"><i data-lucide="shopping-cart"></i> ซื้อสูตร ฿<%=
                    recipe.price.toLocaleString('th-TH') %></button>
      <p data-purchase-status role="status" aria-live="polite"></p>
    </div>
  </section>
  <% } %>
<section class="recipe-review-section" data-recipe-reviews="/recipes/reviews/local/<%= recipe._id %>"><p role="status">กำลังโหลดรีวิว…</p></section>
</div>