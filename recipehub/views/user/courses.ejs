<!DOCTYPE html>
<html lang="th">
<head>
  <%- include('../partials/head', { title: 'คอร์สเรียน' }) %>
  <link rel="stylesheet" href="/stylesheets/recipes.css">
  <link rel="stylesheet" href="/stylesheets/cookhub.css">
</head>
<body class="recipe-site public-recipe-site" data-logged-in="<%= Boolean(typeof currentUser !== 'undefined' && currentUser) %>">
  <%- include('../partials/navbar', { active: 'courses', recipePublicNav: true }) %>

  <main class="cookhub">

  <!-- ================= Hero ================= -->
  <section class="hero hero--list hero--courses">
    <div class="hero__content">
      <h1 class="hero__title">
        <span class="l1">Find Your</span>
        <span class="l2">Perfect Course</span>
      </h1>
      <p class="hero__desc">
        เลือกคอร์สที่ใช่ แล้วเริ่มทำเมนูที่ชอบ<br>
        เรียนรู้จากเชฟผู้เชี่ยวชาญ ตั้งแต่พื้นฐานจนถึงมืออาชีพ<br>
        ครบทุกสไตล์อาหาร ทั้งคาว หวาน และอาหารนานาชาติ
      </p>
    </div>
  </section>

  <div class="container container--wide course-list public-recipe-page">

    <!-- ================= แถบเครื่องมือ (แบบเดียวกับหน้าสูตร: views/partials/browse-controls.ejs) ================= -->
    <form method="get" action="/courses" id="recipe-browse-form">
      <%- include('../partials/browse-controls', {
            filters: filters,
            browseConfig: {
              sourceLabel: 'ระดับ',
              sourceOptions: sourceOptions,
              sortOptions: [['popular', 'ยอดนิยม'], ['rating', 'คะแนนสูงสุด'], ['latest', 'ใหม่ล่าสุด']]
            }
          }) %>
    </form>

    <p class="recipe-results-count">ผลลัพธ์ <strong><%= total %></strong> คอร์ส</p>

    <% if (!courses.length) { %>
      <section class="empty-state">
        <i data-lucide="book-open" class="ic-30"></i>
        <h2>ยังไม่มีคอร์สที่ตรงกับเงื่อนไข</h2>
        <p>ลองเปลี่ยนระดับหรือตัวกรองดูนะ</p>
        <a href="/courses" class="btn btn--outline">ล้างตัวกรอง</a>
      </section>
    <% } %>

    <!-- ================= รายการคอร์ส (จาก database) ================= -->
    <div class="course-grid">
      <% courses.forEach(c => { %>
        <% const favOn = favoriteKeys.has(c.kind + ':' + c.id); %>
          <a href="<%= c.url %>" class="card course-card" <%= loggedIn ? '' : 'data-open-login' %>>
          <div class="card__img">
            <% (c.images && c.images.length ? c.images : ['']).forEach(img => { %>
              <%- include('_image', { src: img, alt: c.title, cls: 'half' }) %>
            <% }) %>
            <div class="tags">
              <span class="tag tag--<%= c.tagType %>"><%= c.tag %></span>
              <% if (c.isPack) { %><span class="tag tag--pack">แพ็กเกจ</span><% } %>
            </div>
            <button class="fav <%= favOn ? 'on' : '' %>" type="button" data-fav-url="/courses/favorites/<%= c.kind %>/<%= c.id %>" aria-pressed="<%= favOn %>" aria-label="รายการโปรด">
              <i data-lucide="heart" class="ic-14"></i>
            </button>
          </div>

          <div class="card__body">
            <div class="card__row">
              <h3 class="card__title">
                <% if (c.isPack) { %>
                  <i data-lucide="package" class="ic-13 pack-icon"></i>
                <% } %>
                <%= c.title %>
              </h3>
              <span class="card__rating"><%= c.rating == null ? 'ใหม่' : '★ ' + c.rating.toFixed(1) %></span>
            </div>
            <p class="card__desc"><%= c.description %></p>

            <div class="chef-mini">
              <%- include('_image', { src: c.chefAvatar, alt: '', cls: 'chef-mini__avatar', icon: 'user' }) %>
              <%= c.chef %>
            </div>

            <div class="card__meta">
              <span>
                <i data-lucide="circle-play" class="ic-12"></i>
                <%= c.lessons %> บทเรียน
              </span>
              <span>
                <i data-lucide="clock-3" class="ic-12"></i>
                <%= c.duration %>
              </span>
              <span>
                <i data-lucide="users" class="ic-12"></i>
                <%= c.students %> คนเรียน
              </span>
            </div>

            <div class="card__foot">
              <span class="price">฿<%= c.price.toLocaleString('en-US') %></span>
              <span class="more">ดูรายละเอียด →</span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>

    <!-- ================= เลขหน้า (แบบเดียวกับหน้าสูตร) ================= -->
    <nav class="recipe-pagination" aria-label="หน้ารายการคอร์ส">
      <% if (page > 1) { %><a href="/courses?<%= pageQuery %>&amp;page=<%= page - 1 %>" aria-label="หน้าก่อนหน้า">‹</a><% } %>
      <span aria-current="page"><%= page %></span><span class="recipe-pagination-total">/ <%= totalPages %></span>
      <% if (page < totalPages) { %><a href="/courses?<%= pageQuery %>&amp;page=<%= page + 1 %>" aria-label="หน้าถัดไป">›</a><% } %>
    </nav>
  </div>
  </main>

  <%# ตัวกรองแบบเลื่อนออกจากด้านข้าง (แบบเดียวกับหน้าสูตร: views/partials/browse-filter.ejs) %>
  <%- include('../partials/browse-filter', {
        filters: filters,
        countryOptions: countryOptions,
        countryLabel: countryLabel,
        filterConfig: { title: 'ตัวกรองคอร์สเรียน', durationTitle: 'ระยะเวลาเรียน (นาที)' }
      }) %>

  <%- include('../partials/footer') %>

  <script src="/javascripts/userFavorites.js"></script>
  <script src="/javascripts/recipeModals.js" defer></script>
</body>
</html>
