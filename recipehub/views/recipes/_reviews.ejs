<div class="recipe-review-heading"><h2><i data-lucide="message-square" aria-hidden="true"></i> รีวิว</h2><span><%= summary.count ? summary.rating.toFixed(1)+' / 5 · '+summary.count+' รีวิว' : 'ยังไม่มีรีวิว' %></span></div>
<% if(reviewClient) { %><% if(mine) { %><details class="recipe-review-editor"><summary><i data-lucide="pencil-line" aria-hidden="true"></i> แก้ไขรีวิวของฉัน</summary><% } %><form class="recipe-review-form" action="<%= reviewPath %>" data-review-token="<%= reviewToken %>"><fieldset><legend>ให้คะแนนสูตรนี้</legend><div class="recipe-review-stars"><% [1,2,3,4,5].forEach(star=>{ %><label><input type="radio" name="rating" aria-label="<%= star %> ดาว" value="<%= star %>" <%= mine&&mine.rating===star?'checked':'' %> required><span aria-hidden="true"><i data-lucide="star"></i></span></label><% }); %><span class="recipe-review-rating-label" data-review-rating-label><%= mine ? mine.rating+' / 5' : 'เลือกคะแนน' %></span></div></fieldset><label class="recipe-review-comment">ความคิดเห็น<textarea name="comment" rows="3" maxlength="2000" placeholder="รสชาติเป็นอย่างไร มีเคล็ดลับอะไรอยากแบ่งปัน?"><%= mine?mine.comment:'' %></textarea></label><div class="recipe-review-actions"><button type="submit" class="recipe-btn recipe-primary"><%= mine?'บันทึกการแก้ไข':'ส่งรีวิว' %></button><% if(mine){ %><button type="button" class="recipe-btn" data-delete-review>ลบรีวิวของฉัน</button><% } %></div><p data-review-status role="status" aria-live="polite"></p></form><% if(mine) { %></details><% } %><% } else { %><p class="recipe-review-login">เข้าสู่ระบบเพื่อให้คะแนนและเขียนรีวิว <button type="button" class="recipe-btn" data-review-login>เข้าสู่ระบบ</button></p><% } %>
<div class="recipe-review-list"><% rows.forEach(row=>{ %><article><div class="recipe-review-user"><% if(row.client&&row.client.avatar){ %><img src="<%= row.client.avatar %>" alt=""><% } %><strong><%= row.client?row.client.name:'ผู้ใช้' %></strong><span class="recipe-review-score recipe-review-display-stars" aria-label="<%= row.rating %> จาก 5 ดาว"><% for(let star=1;star<=5;star++){ %><i data-lucide="star" class="<%= star<=row.rating ? 'is-filled' : '' %>" aria-hidden="true"></i><% } %></span><small><%= new Date(row.updatedAt).toLocaleDateString('th-TH') %></small></div><% if(row.comment){ %><p><%= row.comment %></p><% } %></article><% }); %></div>