<article class="recipe-card public-recipe-card">
        <div class="recipe-card-photo"><a href="/recipes/<%= recipe._id %>" data-recipe-modal="preview"><%-
                      include('_image', { recipe }) %></a><span class="recipe-tag <%= recipe.publisher && recipe.publisher.role === 'chef' ? 'recipe-tag-chef' : '' %>">
            <%= countryLabel(localCountry(recipe.category)) %>
          </span><button type="button" class="recipe-favorite" data-favorite-recipe="<%= recipe._id %>" data-favorite-type="local" aria-pressed="<%= favoriteKeys.has('Recipe:'+recipe._id) %>" aria-label="<%= favoriteKeys.has('Recipe:'+recipe._id) ? 'ยกเลิก' : 'เพิ่ม' %> <%= recipe.title %> เป็นรายการโปรด"><i data-lucide="heart"></i></button></div>
        <div class="recipe-card-body">
          <div class="recipe-card-meta"><span><i data-lucide="clock-3"></i>
              <%= recipe.duration==null ? 'ไม่ระบุเวลา' : recipe.duration + ' นาที' %>
            </span></div>
          <div class="recipe-card-title">
            <h2><a href="/recipes/<%= recipe._id %>" data-recipe-modal="preview">
                <%= recipe.title %>
              </a></h2><span class="recipe-rating">
              <%= recipe.rating==null ? 'ยังไม่มีรีวิว' : '★ ' + recipe.rating.toFixed(1) %>
            </span>
          </div>

          <p class="recipe-card-description recipe-muted">
            <%= recipe.description %>
          </p>
          <p class="recipe-card-chef recipe-muted"><% if (recipe.publisher && recipe.publisher.avatar) { %><img class="recipe-card-chef-avatar" src="<%= recipe.publisher.avatar %>" alt="รูปผู้สร้างสูตร" loading="lazy"><% } else { %><i data-lucide="circle-user-round"></i><% } %>
            <%= recipe.publisher ? recipe.publisher.name : 'เจ้าของสูตร' %>
          </p>
          <div class="recipe-card-bottom"><strong class="recipe-price <%= recipe.price === 0 ? 'recipe-free-price' : '' %>">
              <%= recipe.price===0 ? 'ฟรี' : '฿' + recipe.price.toLocaleString('th-TH') %>
            </strong><a href="/recipes/<%= recipe._id %>" data-recipe-modal="preview" class="recipe-preview-link">ดูสูตร →</a></div>
        </div>
      </article>
      