<%# รูปย่อสี่เหลี่ยมมุมมน ถ้าไม่มีรูปหรือไม่ใช่ http(s) แสดงไอคอนแทน | src, alt %>
<% if (src && /^(https?:\/\/|data:image\/)/i.test(src)) { %>
<img class="chef-thumb" src="<%= src %>" alt="<%= alt %>" loading="lazy" referrerpolicy="no-referrer">
<% } else { %>
<span class="chef-thumb chef-thumb-empty" role="img" aria-label="ไม่มีรูป"><i data-lucide="utensils"></i></span>
<% } %>
