<!DOCTYPE html>
<html lang="th"><head><%- include('../../partials/head', { title }) %><link rel="stylesheet" href="/stylesheets/recipes.css"></head>
<body class="recipe-site chef-recipe-site">
<%- include('../../partials/navbar', { active }) %>
<main class="recipe-page recipe-single-page <%= initialModal.kind === 'form' ? 'recipe-chef-full-page' : '' %>">
<a href="/chef/recipes" class="recipe-back">← จัดการสูตรอาหารของฉัน</a>
<% if(saved) { %><span hidden data-recipe-success="บันทึกสูตรอาหารเรียบร้อยแล้ว"></span><% } %>
<div id="recipe-page-content">
<% if(initialModal.kind === 'form') { %><%- include('_form', { recipe:initialModal.recipe,errors:initialModal.errors,fullPage:true }) %>
<% } else { %>
<%- include('../../user/recipes/_detail', { recipe:initialModal.recipe,canAccess:true,videoEmbed:initialModal.videoEmbed,chefName:recipeChefName }) %>
<% } %>
</div></main>
<%- include('../../partials/footer') %>
<script src="/javascripts/recipeForm.js" defer></script><script src="/javascripts/recipeModals.js" defer></script>
</body></html>