<% const editing = !!recipe._id; const ingredients = recipe.ingredients && recipe.ingredients.length ? recipe.ingredients : [{ name: '', amount: '' }]; const steps = recipe.steps && recipe.steps.length ? recipe.steps : [{ description: '' }]; const categoryOptions = recipeCategories; const selectedCategory = localCountry(recipe.category || 'Thai'); %>
<div class="recipe-modal-heading"><div><h2><i data-lucide="<%= editing ? 'pencil-line' : 'chef-hat' %>"></i> <%= editing ? 'แก้ไขสูตรอาหาร' : 'สร้างสูตรอาหารของคุณ' %></h2><p>กรอกรายละเอียดสูตรอาหารเพื่อแบ่งปันความอร่อย</p></div><a href="/chef/recipes" class="recipe-modal-close" data-close-recipe aria-label="ปิดฟอร์ม"><i data-lucide="x" aria-hidden="true"></i></a></div>
<% if (errors.length) { %><div class="recipe-alert recipe-error" role="alert"><ul><% errors.forEach(error => { %><li><%= error %></li><% }); %></ul></div><% } %>
<form method="post" action="/chef/recipes<%= editing ? '/' + recipe._id : '' %>" class="recipe-form" data-recipe-wizard novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <nav class="recipe-wizard-nav" aria-label="ขั้นตอนสร้างสูตร"><% ['ข้อมูลเมนู','วัตถุดิบ','วิธีทำและตรวจสอบ'].forEach((label,i)=>{ %><button type="button" data-wizard-goto="<%= i %>" <%= i===0 ? 'aria-current="step"' : '' %>><span><%= i+1 %></span><%= label %></button><% }); %></nav>
  <p class="recipe-wizard-progress" aria-live="polite">ขั้นที่ 1 จาก 3 · ข้อมูลเมนู</p>
  <section data-wizard-panel="0" class="recipe-wizard-panel">
  <div class="recipe-form-grid">
    <label>ชื่ออาหาร / เมนู <span class="recipe-required">*</span><input name="title" value="<%= recipe.title || '' %>" maxlength="200" placeholder="เช่น ต้มยำกุ้งน้ำข้นสูตรโบราณ" required></label>
    <div class="recipe-category-field"><span id="recipe-category-label">หมวดหมู่</span><details class="recipe-difficulty-control recipe-form-dropdown"><summary aria-labelledby="recipe-category-label recipe-category-value"><span id="recipe-category-value" data-dropdown-value><%= countryLabel(selectedCategory) %></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="recipe-difficulty-menu" role="group" aria-labelledby="recipe-category-label"><% categoryOptions.forEach(category=>{ %><label class="recipe-difficulty-option"><input type="radio" name="category" value="<%= category %>" <%= selectedCategory===category ? 'checked' : '' %> required><span><%= countryLabel(category) %></span></label><% }); %></div></details></div>
    <label>ราคา (บาท)<input type="number" name="price" value="<%= Number.isFinite(recipe.price) ? recipe.price : '' %>" min="0" step="0.01" required></label>
    <label>เวลาทำ (นาที)<input type="number" name="duration" value="<%= recipe.duration ?? '' %>" min="0" placeholder="เช่น 30"></label>
    <label class="recipe-wide">คำอธิบายสูตรอาหาร<textarea name="description" rows="3" maxlength="10000" placeholder="เล่าจุดเด่น รสชาติ หรือเรื่องราวของเมนูนี้"><%= recipe.description || '' %></textarea></label>
    <input type="hidden" name="image" value="<%= recipe.image || '' %>">
  </div>
  <input type="file" data-recipe-image-file accept="image/jpeg,image/png,image/webp" hidden>
  <button type="button" class="recipe-image-preview recipe-image-upload" data-pick-recipe-image><img data-wizard-image alt="รูปเมนูที่เลือก" hidden><span data-image-placeholder><i data-lucide="image-plus" aria-hidden="true"></i><strong>คลิกเพื่อเลือกรูปเมนู</strong><small>JPG, PNG หรือ WebP · ไม่เกิน 5 MB</small></span><span class="recipe-image-replace" hidden>คลิกเพื่อเปลี่ยนรูป</span></button>
  <p data-image-status class="recipe-image-status" role="status" aria-live="polite"></p>
  </section>
  <section data-wizard-panel="1" class="recipe-wizard-panel" hidden>
  <p class="recipe-wizard-hint">แยกวัตถุดิบเป็นรายการ พร้อมปริมาณที่ใช้ต่อสูตร</p>
  <fieldset><div class="recipe-fieldset-heading"><legend>วัตถุดิบที่ใช้</legend><button type="button" class="recipe-add-row" data-add="ingredient">+ เพิ่มวัตถุดิบ</button></div>
    <div data-rows="ingredient"><% ingredients.forEach(item => { %><div class="recipe-row"><input name="ingredientName" value="<%= item.name %>" maxlength="200" placeholder="ชื่อวัตถุดิบ เช่น กุ้งสด" aria-label="ชื่อวัตถุดิบ" required><input name="ingredientAmount" value="<%= item.amount %>" maxlength="100" placeholder="ปริมาณ เช่น 500 กรัม" aria-label="ปริมาณวัตถุดิบ" required><button type="button" class="recipe-remove" data-remove-row aria-label="ลบวัตถุดิบ"><i data-lucide="trash-2" aria-hidden="true"></i></button></div><% }); %></div>
  </fieldset>
  </section>
  <section data-wizard-panel="2" class="recipe-wizard-panel" hidden>
  <label class="recipe-video-field">ลิงก์คลิป YouTube (ไม่บังคับ)<input type="url" name="videoUrl" maxlength="2000" value="<%= recipe.videoUrl || '' %>" placeholder="https://www.youtube.com/watch?v=..."></label>
  <p class="recipe-wizard-hint">อัปโหลดคลิปไป YouTube แล้วคัดลอกลิงก์มาวางที่นี่ หากไม่ต้องการให้ค้นหาเจอ ให้ตั้งการมองเห็นเป็นไม่เป็นสาธารณะ (Unlisted)</p>
  <fieldset><div class="recipe-fieldset-heading"><legend>ขั้นตอนการทำ</legend><button type="button" class="recipe-add-row" data-add="step">+ เพิ่มขั้นตอน</button></div>
    <div data-rows="step"><% steps.forEach((step, i) => { %><div class="recipe-row recipe-step-row"><span data-step-label class="recipe-step-number"><%= i + 1 %></span><textarea name="stepDescription" rows="1" maxlength="4000" placeholder="อธิบายขั้นตอนการทำ" aria-label="ขั้นตอนการทำ" required><%= step.description %></textarea><button type="button" class="recipe-remove" data-remove-row aria-label="ลบขั้นตอน"><i data-lucide="trash-2" aria-hidden="true"></i></button></div><% }); %></div>
  </fieldset>
  <aside class="recipe-wizard-review"><h3>ตรวจสอบก่อนบันทึก</h3><div data-wizard-review></div></aside>
  </section>
  <div class="recipe-modal-footer recipe-wizard-footer"><button type="button" class="recipe-btn" data-wizard-back hidden>ย้อนกลับ</button><button type="button" class="recipe-btn recipe-primary" data-wizard-next>ถัดไป</button><a class="recipe-btn" href="/chef/recipes" data-close-recipe>ยกเลิก</a><button class="recipe-btn recipe-primary" type="submit" data-wizard-save hidden><%= editing ? 'บันทึกการแก้ไข' : 'สร้างสูตรอาหาร' %></button></div>
</form>
<template data-template="ingredient"><div class="recipe-row"><input name="ingredientName" maxlength="200" placeholder="ชื่อวัตถุดิบ เช่น กุ้งสด" aria-label="ชื่อวัตถุดิบ" required><input name="ingredientAmount" maxlength="100" placeholder="ปริมาณ เช่น 500 กรัม" aria-label="ปริมาณวัตถุดิบ" required><button type="button" class="recipe-remove" data-remove-row aria-label="ลบวัตถุดิบ"><i data-lucide="trash-2" aria-hidden="true"></i></button></div></template>
<template data-template="step"><div class="recipe-row recipe-step-row"><span data-step-label class="recipe-step-number"></span><textarea name="stepDescription" rows="1" maxlength="4000" placeholder="อธิบายขั้นตอนการทำ" aria-label="ขั้นตอนการทำ" required></textarea><button type="button" class="recipe-remove" data-remove-row aria-label="ลบขั้นตอน"><i data-lucide="trash-2" aria-hidden="true"></i></button></div></template>
