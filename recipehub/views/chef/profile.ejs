<!DOCTYPE html>
<html lang="th">

<head>
  <%- include('../partials/head', { title }) %>
  <link rel="stylesheet" href="/stylesheets/profile.css">
</head>

<body>
  <%- include('../partials/navbar', { active }) %>

  <main class="profile-page">

    <% if (saved) { %>
    <div class="alert-success" role="status">
      <i data-lucide="circle-check"></i> บันทึกการแก้ไขเรียบร้อยแล้ว
    </div>
    <% } %>
    <% if (errors.length) { %>
    <div class="alert-error" role="alert">
      <% errors.forEach(e => { %><div><%= e %></div><% }) %>
    </div>
    <% } %>

    <!-- ===== การ์ดหัวโปรไฟล์ (ข้อมูลจริงจาก MongoDB) ===== -->
    <section class="card profile-header">
      <div class="avatar-wrap">
        <div class="avatar-circle">
          <img id="avatarPreview" src="<%= user.avatar %>" alt="รูปโปรไฟล์" <%= user.avatar ? '' : 'hidden' %>>
          <i data-lucide="user" id="avatarPlaceholder" class="avatar-placeholder" <%= user.avatar ? 'hidden' : '' %>></i>
        </div>
        <label for="avatarInput" class="avatar-camera" aria-label="เปลี่ยนรูปโปรไฟล์">
          <i data-lucide="camera"></i>
        </label>
        <input type="file" id="avatarInput" accept="image/*" hidden>
      </div>

      <div class="profile-info">
        <h1>เชฟ<%= user.name %></h1>
        <a href="mailto:<%= user.email %>" class="profile-email"><%= user.email %></a>
        <p class="profile-sub"><%= user.institution || 'ยังไม่ได้ระบุสถาบัน' %></p>
        <span class="verify-pill <%= user.isVerifiedChef ? 'ok' : 'wait' %>">
          <%= user.isVerifiedChef ? '✓ ผ่านการรับรอง (Verified)' : 'รอการตรวจสอบบัญชีเชฟ' %>
        </span>
        <p class="avatar-note" id="avatarNote" hidden>เลือกรูปแล้ว กด “บันทึกการแก้ไข” เพื่อบันทึกรูปโปรไฟล์</p>
      </div>
    </section>

    <!-- ===== ฟอร์มข้อมูลส่วนตัว ===== -->
    <section class="card">
      <h2 class="card-title">ข้อมูลส่วนตัว</h2>

      <form action="/chef/profile" method="POST" class="profile-form" id="profileForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%# รูปที่ย่อแล้วจาก profile.js จะถูกใส่ในช่องนี้ก่อนส่งฟอร์ม %>
        <input type="hidden" name="avatarData" id="avatarData" value="">
        <div class="form-grid">
          <div class="form-group">
            <label for="firstName">ชื่อ</label>
            <input type="text" id="firstName" name="firstName" value="<%= form.firstName %>" maxlength="80" required>
          </div>

          <div class="form-group">
            <label for="lastName">นามสกุล</label>
            <input type="text" id="lastName" name="lastName" value="<%= form.lastName %>" maxlength="80">
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= form.email %>" required>
          </div>

          <div class="form-group">
            <label for="institution">สถาบันการศึกษา / สถาบันทำอาหารที่จบมา</label>
            <input type="text" id="institution" name="institution" value="<%= form.institution %>" maxlength="200">
          </div>

          <div class="form-group full">
            <label for="bio">แนะนำตัว</label>
            <textarea id="bio" name="bio" rows="4" maxlength="300"><%= form.bio %></textarea>
            <span class="char-count"><span id="bioCount">0</span>/300</span>
          </div>
        </div>

        <button type="submit" class="btn-primary">บันทึกการแก้ไข</button>
      </form>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <script src="/javascripts/profile.js"></script>
</body>

</html>
