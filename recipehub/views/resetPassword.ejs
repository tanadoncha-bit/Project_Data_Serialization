<!DOCTYPE html>
<html lang="th">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="reset-page">
    <div class="reset-card">
      <div class="auth-logo"><i data-lucide="key-round"></i></div>

      <% if (done) { %>
        <!-- ===== ตั้งรหัสสำเร็จ ===== -->
        <h2>ตั้งรหัสผ่านใหม่เรียบร้อย</h2>
        <p class="auth-sub">ใช้รหัสผ่านใหม่เข้าสู่ระบบได้เลย</p>
        <a href="/home?login=1" class="auth-submit reset-btn">เข้าสู่ระบบ</a>

      <% } else if (!valid) { %>
        <!-- ===== ลิงก์ใช้ไม่ได้ ===== -->
        <h2>ลิงก์หมดอายุหรือใช้ไปแล้ว</h2>
        <p class="auth-sub">กรุณากด "ลืมรหัสผ่าน" อีกครั้งเพื่อขอลิงก์ใหม่</p>
        <a href="/home?login=1" class="auth-submit reset-btn">กลับหน้าแรก</a>

      <% } else { %>
        <!-- ===== ฟอร์มตั้งรหัสใหม่ ===== -->
        <h2>ตั้งรหัสผ่านใหม่</h2>
        <p class="auth-sub">รหัสผ่านอย่างน้อย 6 ตัวอักษร</p>
        <form method="POST" class="auth-form">
          <% if (error) { %><p class="auth-error" role="alert"><%= error %></p><% } %>
          <label for="newPassword">New Password</label>
          <input type="password" id="newPassword" name="password" autocomplete="new-password" required minlength="6">
          <label for="newConfirm">Confirm Password</label>
          <input type="password" id="newConfirm" name="confirmPassword" autocomplete="new-password" required minlength="6">
          <button type="submit" class="auth-submit">บันทึกรหัสผ่านใหม่</button>
        </form>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
